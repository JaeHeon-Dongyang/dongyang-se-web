# 실제 값은 .env.local 에 넣는다 (.env.local 은 git 에 커밋하지 않음).
# 배포 환경(Vercel)에서는 프로젝트 환경변수로 등록한다.

# --- 사이트 ---
# 절대 URL. 메타데이터/OG/sitemap 에 사용. Vercel 환경변수에도 등록할 것.
# 현재 배포: https://dongyang-web-nine.vercel.app
NEXT_PUBLIC_SITE_URL="https://dongyang-web-nine.vercel.app"

# --- 문의 폼 이메일 전송 (Resend) ---
# https://resend.com 에서 발급. 서버 라우트에서만 사용, 클라이언트 노출 금지.
RESEND_API_KEY=""

# 수신 주소 (마스터 프롬프트 기준 고정값). 여러 개는 콤마로 구분.
CONTACT_TO_EMAIL="dy8000@daum.net"

# 발신 주소. Resend 에서 도메인 인증(SPF/DKIM)이 끝난 도메인이어야 한다.
# 도메인 인증 전에는 Resend 테스트 발신 주소(onboarding@resend.dev)로만 동작.
CONTACT_FROM_EMAIL="no-reply@example.com"

# --- 스팸 방지 (선택, 후속 단계) ---
# Cloudflare Turnstile 등 캡차 연동 시 사용.
TURNSTILE_SECRET_KEY=""
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
