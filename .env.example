# 실제 값은 .env.local 에 넣는다 (.env.local 은 git 에 커밋하지 않음).
# 배포 환경(Vercel)에서는 프로젝트 환경변수로 등록한다.

# --- 사이트 ---
# 절대 URL (메타데이터/OG/sitemap). 선택 사항:
#  - Vercel 배포 시 VERCEL_PROJECT_PRODUCTION_URL 을 자동 폴백하므로 보통 비워도 됨
#    (Vercel 프로젝트: dongyang-se-web-tu)
#  - 실제 도메인(예: https://dongyang.co.kr) 연결 시에만 아래에 지정
# NEXT_PUBLIC_SITE_URL="https://dongyang.example.com"

# --- 문의 폼 이메일 전송 (Resend) ---
# 자세한 절차는 docs/deployment.md 참고. 서버에서만 사용, 클라이언트 노출 금지.
RESEND_API_KEY=""

# 발신 주소:
#  - 도메인 없이(내부/테스트): onboarding@resend.dev
#    → 이때 수신은 "Resend 가입 이메일"로만 가능 (다른 주소로 보내면 발송 거부)
#  - 운영: 인증(SPF/DKIM)이 끝난 도메인 주소 (예: no-reply@dongyang.co.kr)
CONTACT_FROM_EMAIL="onboarding@resend.dev"

# 수신 주소. 여러 개는 콤마로 구분. 미설정 시 lib/site.ts 의 회사 이메일(dy8000@daum.net) 사용.
#  - onboarding@resend.dev 를 발신으로 쓰는 동안에는 반드시 "Resend 가입 이메일"과 같아야 한다.
CONTACT_TO_EMAIL="dy8000@daum.net"

# --- 네이버 지도 임베드 (/contact) ---
# 네이버 클라우드 플랫폼(console.ncloud.com) → AI·NAVER API → Maps 신청 후 발급되는
# Client ID(ncpKeyId). 콘솔에서 Web Dynamic Map을 선택하고 배포 도메인
# (https://dongyang-se-web-tu.vercel.app)과 localhost를 Web 서비스 URL로 등록해야 한다.
# 지도 중심 좌표를 코드에 보관하므로 Geocoding API는 선택하지 않아도 된다.
# 미설정 시 지도는 렌더링하지 않고 "네이버 지도에서 위치 보기" 링크만 표시(AGENTS.md 요건).
NEXT_PUBLIC_NAVER_MAP_CLIENT_ID=""

# --- 제한 가능 페이지(/ask, /resources) 접근 설정 ---
# 기본값은 외부 공개. 중요 자료가 올라가 사내 전용으로 전환할 때 true 로 설정한다.
INTRANET_LOCK_ENABLED="false"

# 사무실 회선의 "공인 IP"를 콤마로 구분해 넣는다 (예: "203.0.113.10,203.0.113.11").
# 사설 IP(192.168.x.x 등)는 동작하지 않는다 — 밖에서 보이는 주소여야 한다.
# 확인: 사무실 PC에서 "내 아이피" 검색 → 나온 값. 유동 IP면 바뀔 때마다 갱신해야 한다.
# INTRANET_LOCK_ENABLED=true 인데 이 값이 비어 있으면 모든 접근을 차단한다.
INTRANET_ALLOWED_IPS=""

# --- 스팸 방지 (선택, 후속 단계) ---
# Cloudflare Turnstile 등 캡차 연동 시 사용.
TURNSTILE_SECRET_KEY=""
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
